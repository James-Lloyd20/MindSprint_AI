@model LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="row justify-content-center g-4 auth-page">
    <div class="col-md-8 col-lg-6 auth-form">
<h1 class="h3 mb-3 mindsprint-title">Đăng nhập</h1>
        <form method="post" data-machine-light="true">
            <div asp-validation-summary="All" class="text-danger small"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
            </div>
            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <partial name="_Turnstile" />
            <button class="btn btn-primary w-100">Đăng nhập</button>
        </form>
        <partial name="_ExternalLoginButtons" model="Model" />
        <form method="post" asp-action="PasskeyLogin" data-action="PasskeyLogin" data-passkey="get" data-options="@Url.Content("~/Account/PasskeyRequestOptions")" class="mt-3">
            <input type="hidden" name="credentialJson" value="" />
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <input type="hidden" name="rememberMe" value="false" />
            <div data-passkey-controls hidden><button class="btn btn-outline-primary w-100">Đăng nhập bằng Passkey</button>
            <p class="small mt-2">Dùng vân tay, khuôn mặt hoặc mã PIN của thiết bị.</p></div>
            <p class="small mt-2" role="status" aria-live="polite" data-passkey-status></p>
            <noscript>Trình duyệt đang tắt JavaScript (phần giúp trang web hoạt động). Hãy bật lại JavaScript trong cài đặt trình duyệt để đăng nhập bằng Passkey.</noscript>
        </form>
        @if (!string.IsNullOrWhiteSpace(Model.Email))
        {
            <a asp-action="ResendConfirmation" asp-route-email="@Model.Email" class="btn btn-link mt-2 p-2">Gửi lại email xác minh</a>
        }
        <p class="mt-3 small">
            <a asp-action="ForgotPassword">Quên mật khẩu?</a> · Chưa có tài khoản? <a asp-action="Register">Đăng ký</a>
        </p>
        <p class="small text-muted">Để báo cho bạn khi có đăng nhập từ máy lạ, MindSprint AI ghi nhận địa chỉ mạng (IP), vị trí ước tính và một số đặc điểm chung của máy. <a asp-controller="Home" asp-action="Privacy">Xem chi tiết</a></p>
    </div>
    <aside class="col-lg-6 d-none d-lg-block auth-photo" aria-label="Góc học tập">
        <img class="study-photo" src="~/img/landing/photo-c822.webp" width="1280" height="854" alt="Hai bút chì trên nền vàng" loading="lazy" decoding="async" data-source="library-057" data-subject="desk" />
        <p class="small photo-credit">Nguồn ảnh: <a href="https://commons.wikimedia.org/wiki/File:Minimal_pencils_on_yellow_(Unsplash).jpg">Joanna Kosinska</a> · <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a>.</p>
    </aside>
</div>
@section Scripts { <script src="~/js/passkey.js" asp-append-version="true"></script> }
